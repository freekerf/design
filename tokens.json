{
  "$description": "FreeKerf design tokens — formato W3C Design Tokens (DTCG). Fonte única: gere o CSS com `python3 tokens/build_tokens.py`. Prefixo de saída: fk-.",
  "fk": {
    "color": {
      "$type": "color",
      "brand": {
        "$description": "Âmbar Kerf: cor da marca. Âmbar continua visível através de óculos de proteção laranja (diodo 445 nm) e não é vermelho/verde puro.",
        "amber-50":  { "$value": "#FFF7E6" },
        "amber-100": { "$value": "#FFEBC2" },
        "amber-200": { "$value": "#FFD88A" },
        "amber-300": { "$value": "#FFC456" },
        "amber-400": { "$value": "#F9B23A" },
        "amber-500": { "$value": "#F4A51C", "$description": "Cor da marca" },
        "amber-600": { "$value": "#D98A00" },
        "amber-700": { "$value": "#B86E00" },
        "amber-800": { "$value": "#8A5200" },
        "amber-900": { "$value": "#5C3700" }
      },
      "neutral": {
        "$description": "Grafite: neutros levemente frios, como aço e chapa.",
        "0":   { "$value": "#FFFFFF" },
        "50":  { "$value": "#F6F7F9" },
        "100": { "$value": "#EBEEF2" },
        "200": { "$value": "#D3D9E0" },
        "300": { "$value": "#AAB3BF" },
        "400": { "$value": "#808B9A" },
        "500": { "$value": "#5B6675" },
        "600": { "$value": "#3A434F" },
        "700": { "$value": "#28303A" },
        "800": { "$value": "#1D232B" },
        "850": { "$value": "#181D24" },
        "900": { "$value": "#151A20" },
        "950": { "$value": "#0E1115" },
        "1000": { "$value": "#000000" }
      },
      "signal": {
        "$description": "Cores de sinal. Nunca usadas sozinhas: sempre com ícone + rótulo (+ padrão no estado Executando).",
        "cyan-400":    { "$value": "#4CC2E0" },
        "cyan-700":    { "$value": "#0B6F87" },
        "violet-400":  { "$value": "#A99BFF" },
        "violet-700":  { "$value": "#5B47D6" },
        "magenta-400": { "$value": "#FF5C8A" },
        "magenta-700": { "$value": "#C2185B" },
        "teal-400":    { "$value": "#2CC5A9" },
        "teal-700":    { "$value": "#0B7A66" },
        "yellow-300":  { "$value": "#FFD23F" },
        "yellow-700":  { "$value": "#8C6A00" },
        "estop-500":   { "$value": "#D33027", "$description": "Somente para a parada de emergência (convenção ISO 13850: vermelho sobre amarelo, com forma octogonal e texto)." }
      },
      "layer": {
        "$description": "Cores de camada (C00–C11 + ferramenta T1). Escolhidas a partir de Okabe-Ito/Tol e ajustadas para luminância média, legíveis em fundo claro e escuro. A identificação nunca é só por cor: cada camada tem código de 2 dígitos e padrão de traço próprio.",
        "c00": { "$value": "#4C8DFF", "$description": "Azul" },
        "c01": { "$value": "#E8622C", "$description": "Vermelhão" },
        "c02": { "$value": "#10A37F", "$description": "Verde-azulado" },
        "c03": { "$value": "#E8C21F", "$description": "Amarelo" },
        "c04": { "$value": "#B36AE2", "$description": "Púrpura" },
        "c05": { "$value": "#52B8E8", "$description": "Céu" },
        "c06": { "$value": "#E0559A", "$description": "Rosa" },
        "c07": { "$value": "#F08C1A", "$description": "Laranja" },
        "c08": { "$value": "#8FA31E", "$description": "Oliva" },
        "c09": { "$value": "#7F8EA3", "$description": "Ardósia" },
        "c10": { "$value": "#A0693A", "$description": "Marrom" },
        "c11": { "$value": "#25C2B5", "$description": "Turquesa" },
        "t1":  { "$value": "#9AA3AF", "$description": "Camada de ferramenta: visível, nunca é enviada ao laser" }
      }
    },
    "theme": {
      "$description": "Tokens semânticos por tema. Escuro é o padrão (oficina com pouca luz). O CSS gera [data-theme=dark|light] e [data-contrast=high].",
      "dark": {
        "$type": "color",
        "surface-0":       { "$value": "{fk.color.neutral.950}", "$description": "Fundo do app" },
        "surface-1":       { "$value": "{fk.color.neutral.900}", "$description": "Painéis" },
        "surface-2":       { "$value": "{fk.color.neutral.800}", "$description": "Campos, cartões" },
        "surface-3":       { "$value": "{fk.color.neutral.700}", "$description": "Hover/pressionado" },
        "surface-canvas":  { "$value": "#0B0D10", "$description": "Fora da área de trabalho" },
        "surface-workarea":{ "$value": "#12161B", "$description": "Mesa da máquina" },
        "border":          { "$value": "{fk.color.neutral.700}" },
        "border-strong":   { "$value": "{fk.color.neutral.500}" },
        "text":            { "$value": "{fk.color.neutral.100}" },
        "text-muted":      { "$value": "{fk.color.neutral.300}" },
        "text-subtle":     { "$value": "{fk.color.neutral.400}" },
        "accent":          { "$value": "{fk.color.brand.amber-500}" },
        "accent-hover":    { "$value": "{fk.color.brand.amber-400}" },
        "accent-text":     { "$value": "{fk.color.brand.amber-400}" },
        "on-accent":       { "$value": "{fk.color.neutral.950}" },
        "focus":           { "$value": "{fk.color.brand.amber-300}" },
        "selection":       { "$value": "{fk.color.brand.amber-400}" },
        "grid-minor":      { "$value": "#1A2027" },
        "grid-major":      { "$value": "#26303A" },
        "ruler-bg":        { "$value": "{fk.color.neutral.900}" },
        "ruler-text":      { "$value": "{fk.color.neutral.400}" },
        "state-offline":   { "$value": "{fk.color.neutral.500}" },
        "state-idle":      { "$value": "{fk.color.signal.cyan-400}" },
        "state-run":       { "$value": "{fk.color.brand.amber-500}" },
        "state-hold":      { "$value": "{fk.color.signal.violet-400}" },
        "state-alarm":     { "$value": "{fk.color.signal.magenta-400}" },
        "success":         { "$value": "{fk.color.signal.teal-400}" },
        "warning":         { "$value": "{fk.color.signal.yellow-300}" },
        "danger":          { "$value": "{fk.color.signal.magenta-400}" },
        "estop":           { "$value": "{fk.color.signal.estop-500}" },
        "estop-ring":      { "$value": "{fk.color.signal.yellow-300}" },
        "head":            { "$value": "#FFFFFF", "$description": "Cabeçote/mira no canvas" },
        "burn":            { "$value": "#FFB547", "$description": "Rastro de queima na simulação" }
      },
      "light": {
        "$type": "color",
        "surface-0":       { "$value": "{fk.color.neutral.100}" },
        "surface-1":       { "$value": "{fk.color.neutral.0}" },
        "surface-2":       { "$value": "{fk.color.neutral.50}" },
        "surface-3":       { "$value": "{fk.color.neutral.200}" },
        "surface-canvas":  { "$value": "#DCE1E7" },
        "surface-workarea":{ "$value": "#FBFBFC" },
        "border":          { "$value": "{fk.color.neutral.200}" },
        "border-strong":   { "$value": "{fk.color.neutral.400}" },
        "text":            { "$value": "{fk.color.neutral.900}" },
        "text-muted":      { "$value": "{fk.color.neutral.600}" },
        "text-subtle":     { "$value": "{fk.color.neutral.500}" },
        "accent":          { "$value": "{fk.color.brand.amber-500}" },
        "accent-hover":    { "$value": "{fk.color.brand.amber-600}" },
        "accent-text":     { "$value": "{fk.color.brand.amber-800}" },
        "on-accent":       { "$value": "{fk.color.neutral.950}" },
        "focus":           { "$value": "{fk.color.brand.amber-700}" },
        "selection":       { "$value": "{fk.color.brand.amber-700}" },
        "grid-minor":      { "$value": "#EEF1F4" },
        "grid-major":      { "$value": "#D8DEE5" },
        "ruler-bg":        { "$value": "{fk.color.neutral.50}" },
        "ruler-text":      { "$value": "{fk.color.neutral.500}" },
        "state-offline":   { "$value": "{fk.color.neutral.500}" },
        "state-idle":      { "$value": "{fk.color.signal.cyan-700}" },
        "state-run":       { "$value": "{fk.color.brand.amber-700}" },
        "state-hold":      { "$value": "{fk.color.signal.violet-700}" },
        "state-alarm":     { "$value": "{fk.color.signal.magenta-700}" },
        "success":         { "$value": "{fk.color.signal.teal-700}" },
        "warning":         { "$value": "{fk.color.signal.yellow-700}" },
        "danger":          { "$value": "{fk.color.signal.magenta-700}" },
        "estop":           { "$value": "{fk.color.signal.estop-500}" },
        "estop-ring":      { "$value": "{fk.color.signal.yellow-300}" },
        "head":            { "$value": "#151A20" },
        "burn":            { "$value": "#8A5200" }
      },
      "high-contrast": {
        "$type": "color",
        "$description": "Sobrepõe o tema escuro: preto puro, bordas brancas, texto branco. Para luz forte, distância e óculos de proteção.",
        "surface-0":       { "$value": "#000000" },
        "surface-1":       { "$value": "#000000" },
        "surface-2":       { "$value": "#0A0A0A" },
        "surface-3":       { "$value": "#262626" },
        "surface-canvas":  { "$value": "#000000" },
        "surface-workarea":{ "$value": "#0A0A0A" },
        "border":          { "$value": "#FFFFFF" },
        "border-strong":   { "$value": "#FFFFFF" },
        "text":            { "$value": "#FFFFFF" },
        "text-muted":      { "$value": "#FFFFFF" },
        "text-subtle":     { "$value": "#E0E0E0" },
        "accent":          { "$value": "#FFC456" },
        "accent-text":     { "$value": "#FFC456" },
        "focus":           { "$value": "#FFFFFF" },
        "grid-minor":      { "$value": "#1C1C1C" },
        "grid-major":      { "$value": "#4A4A4A" }
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "ui":    { "$value": ["Inter", "system-ui", "Segoe UI", "Cantarell", "Noto Sans", "sans-serif"], "$description": "OFL-1.1" },
        "mono":  { "$value": ["JetBrains Mono", "ui-monospace", "Menlo", "Consolas", "monospace"], "$description": "OFL-1.1; números do DRO, console, G-code" },
        "brand": { "$value": ["Space Grotesk", "Inter", "sans-serif"], "$description": "OFL-1.1; apenas wordmark e títulos de marketing" }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 }, "bold": { "$value": 700 }
      },
      "size": {
        "$type": "dimension",
        "xs":  { "$value": "11px" },
        "sm":  { "$value": "12px" },
        "md":  { "$value": "13px", "$description": "Corpo no modo compacto" },
        "lg":  { "$value": "15px", "$description": "Corpo no modo toque" },
        "xl":  { "$value": "18px" },
        "2xl": { "$value": "22px" },
        "3xl": { "$value": "28px" },
        "readout": { "$value": "40px", "$description": "Estado/progresso legível a ~2 m" },
        "readout-xl": { "$value": "64px", "$description": "Modo bancada/painel de status" }
      },
      "line-height": {
        "$type": "number",
        "tight": { "$value": 1.15 }, "base": { "$value": 1.45 }
      }
    },
    "space": {
      "$type": "dimension",
      "0":  { "$value": "0px" },
      "half": { "$value": "2px" },
      "1":  { "$value": "4px" },
      "2":  { "$value": "8px" },
      "3":  { "$value": "12px" },
      "4":  { "$value": "16px" },
      "5":  { "$value": "20px" },
      "6":  { "$value": "24px" },
      "8":  { "$value": "32px" },
      "10": { "$value": "40px" },
      "12": { "$value": "48px" }
    },
    "radius": {
      "$type": "dimension",
      "sm": { "$value": "4px" }, "md": { "$value": "6px" }, "lg": { "$value": "10px" }, "xl": { "$value": "14px" }, "full": { "$value": "999px" }
    },
    "elevation": {
      "$type": "shadow",
      "1": { "$value": { "color": "#00000040", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" } },
      "2": { "$value": { "color": "#00000059", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px" } },
      "3": { "$value": { "color": "#00000073", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px" } }
    },
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" }, "base": { "$value": "200ms" }, "slow": { "$value": "320ms" }
    },
    "z": {
      "$type": "number",
      "panel": { "$value": 10 }, "drawer": { "$value": 30 }, "popover": { "$value": 40 }, "toast": { "$value": 50 }, "dialog": { "$value": 60 }, "estop": { "$value": 100 }
    },
    "density": {
      "$description": "Dois conjuntos. Compacto: mouse/caneta. Confortável: toque. Alternados por [data-density].",
      "compact": {
        "$type": "dimension",
        "control-h":   { "$value": "28px" },
        "icon-btn":    { "$value": "32px" },
        "row-h":       { "$value": "30px" },
        "hit-min":     { "$value": "24px", "$description": "WCAG 2.5.8 (AA)" },
        "handle":      { "$value": "8px" },
        "handle-hit":  { "$value": "16px" },
        "font-body":   { "$value": "{fk.font.size.md}" },
        "gap":         { "$value": "{fk.space.2}" },
        "jog-btn":     { "$value": "44px" }
      },
      "comfortable": {
        "$type": "dimension",
        "control-h":   { "$value": "44px" },
        "icon-btn":    { "$value": "48px" },
        "row-h":       { "$value": "48px" },
        "hit-min":     { "$value": "44px", "$description": "WCAG 2.5.5 (AAA) / Apple HIG" },
        "handle":      { "$value": "16px" },
        "handle-hit":  { "$value": "44px" },
        "font-body":   { "$value": "{fk.font.size.lg}" },
        "gap":         { "$value": "{fk.space.3}" },
        "jog-btn":     { "$value": "72px" }
      }
    }
  }
}
